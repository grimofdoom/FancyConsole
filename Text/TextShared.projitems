    <Compile Include="$(MSBuildThisFileDirectory)Color.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Print.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PrintExtend\PrintColor.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PrintExtend\PrintEffects.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PrintExtend\PrintLogging.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)printextend\PrintStatusBar.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Read.cs" />
